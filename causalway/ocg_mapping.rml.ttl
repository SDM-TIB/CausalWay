# RML mapping: OntologicalCausalGraph JSON -> cw: RDF.
#
# This file *is* the specification of how a causal graph becomes triples.
# Nothing in `causalway/result.py` adds a triple of its own; `to_rdf` writes the
# JSON that `to_json` produced, hands this mapping to SDM-RDFizer, and parses
# the result back.  Change the shape of the exported graph here, not in Python.
#
# The shape it writes (see `causalway/vocab.py` for the terms, and
# `causalway/shapes.ttl` for the constraints they must satisfy):
#
#   graph  cw:discoveredBy run
#   run    cw:sourceKG, cw:byMethod, cw:discoveredTime, cw:hasParameter param*
#   param  cw:parameterName, cw:parameterValue (typed), rdfs:comment?
#   node   rdfs:label, cw:inGraph, cw:domain, cw:property, cw:range
#   edge   rdfs:label, cw:inGraph, cw:cause, cw:effect, cw:curated,
#          cw:weight?, cw:viaRelationalPath*
#
# Every logical source reads the *same* document (`ocg.json`, resolved relative
# to the process working directory — SDM-RDFizer does not resolve it against
# the config's `main_directory`) under a different JSONPath iterator.  The JSON
# is deliberately denormalised: each record carries every field its triples
# map needs, so no triples map uses `rr:parentTriplesMap`.  That is not a
# stylistic choice — SDM-RDFizer 4.7.5 emits a malformed IRI where a join onto
# a blank-node parent should go, and drops all but the last matching row.
#
# Four further facts about that engine are baked into the shapes below.
#
#   1. Carrying an IRI through takes a *different* idiom on each side of the
#      triple, and they are exact opposites.  Verified against SDM-RDFizer
#      4.7.5; do not "make them consistent".
#
#        | position | rr:template "{f}"             | rml:reference "f" (+ rr:IRI) |
#        |----------|-------------------------------|------------------------------|
#        | subject  | percent-encoded, re-based to  | **verbatim**                 |
#        |          | http://example.com/base/      |                              |
#        | object   | **verbatim**                  | percent-encoded              |
#
#      So every subject template here spells out its IRI stem literally and
#      interpolates only slug-safe key fragments, while a foreign IRI (a domain
#      class, a property) travels as an *object* `rr:template "{field}"` +
#      `rr:termType rr:IRI`.  A foreign IRI in *subject* position needs
#      `rml:reference` + `rr:termType rr:IRI` instead — none is needed here.
#
#   2. There is no working collection support (`rml:gather` / `rml:gatherAs`
#      is parsed and silently produces nothing).  That is why an edge's
#      relational path is one SPARQL 1.1 property-path *literal* (`^<a>/<b>`)
#      rather than an `rdf:List` of properties — and the literal is better
#      anyway: `^` carries each hop's direction, which a list of IRIs loses.
#
#   3. A literal produced through `rml:reference` has both `"` and `'`
#      rewritten to `\'`, irreversibly.  `to_rdf` refuses to export any literal
#      containing a quote rather than write a corrupted one.
#
#   4. `rml:datatypeMap` works per row, but a row whose `datatype` key is
#      *absent* takes the whole triples map down, and an *empty* one drops the
#      value.  Typed and untyped parameter values therefore travel in separate
#      arrays (`parameters_typed` / `parameters`), and every typed row carries a
#      `datatype`.
#
# Absent JSON keys yield no triple, which is how the optional `cw:weight` and
# `rdfs:comment` are expressed: `to_json` omits the key rather than emitting
# null.  An *empty* reference value is not treated as absent — the engine
# writes the literal "None" — which is why `to_json` drops the key entirely.

@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix cw:   <http://sdm-causalway.org/> .


# ------------------------------------------------------------------ #
# The graph and the run that discovered it
# ------------------------------------------------------------------ #
<#GraphMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "ocg.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.graph[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/graph/{gid}" ;
        rr:class cw:OntologicalCausalGraph
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:discoveredBy ;
        rr:objectMap [ rr:template "{run_iri}" ; rr:termType rr:IRI ]
    ] .

<#RunMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "ocg.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.run[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/run/{gid}" ;
        rr:class cw:CausalDiscoveryRun
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:sourceKG ;
        rr:objectMap [ rml:reference "source" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:byMethod ;
        rr:objectMap [ rml:reference "method" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:discoveredTime ;
        rr:objectMap [ rml:reference "discovered_time" ; rr:datatype xsd:dateTime ]
    ] .


# ------------------------------------------------------------------ #
# Parameters.  One cw:Parameter per name, its value a typed literal: a
# string parameter is a plain literal (RDF 1.1: that *is* xsd:string), every
# other one carries its xsd datatype per row.  See fact 4 in the header for
# why the two travel in separate arrays.
# ------------------------------------------------------------------ #
<#ParameterMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "ocg.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.parameters[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/run/{gid}/parameter/{param_key}" ;
        rr:class cw:Parameter
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:parameterName ;
        rr:objectMap [ rml:reference "name" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:parameterValue ;
        rr:objectMap [ rml:reference "value" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:comment ;
        rr:objectMap [ rml:reference "comment" ]
    ] .

<#ParameterTypedMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "ocg.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.parameters_typed[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/run/{gid}/parameter/{param_key}" ;
        rr:class cw:Parameter
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:parameterName ;
        rr:objectMap [ rml:reference "name" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:parameterValue ;
        rr:objectMap [ rml:reference "value" ; rml:datatypeMap [ rml:template "{datatype}" ] ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:comment ;
        rr:objectMap [ rml:reference "comment" ]
    ] .

<#RunHasParameterMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "ocg.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.run_parameters[*]"
    ] ;
    rr:subjectMap [ rr:template "http://sdm-causalway.org/run/{gid}" ] ;
    rr:predicateObjectMap [
        rr:predicate cw:hasParameter ;
        rr:objectMap [ rr:template "{parameter_iri}" ; rr:termType rr:IRI ]
    ] .


# ------------------------------------------------------------------ #
# Causal nodes — (D_p, p, R_p), one per graph.  A node belongs to exactly one
# graph (cw:inGraph), so two graphs over the same property have two nodes, and
# comparing them joins on (cw:domain, cw:property, cw:range), not on the IRI.
# That is what lets SHACL check a graph's acyclicity by a property path that
# cannot wander into another graph's edges.
# ------------------------------------------------------------------ #
<#NodeMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "ocg.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.nodes[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/graph/{gid}/node/{node_key}" ;
        rr:class cw:CausalNode
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "label" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:inGraph ;
        rr:objectMap [ rr:template "{graph_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:domain ;
        rr:objectMap [ rr:template "{domain}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:property ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] ;
    # One range term for a class and for a datatype alike, exactly as
    # rdfs:range is one term.  Whether the node is a data or an object property
    # is read off it: a datatype range is a data property.
    rr:predicateObjectMap [
        rr:predicate cw:range ;
        rr:objectMap [ rr:template "{range}" ; rr:termType rr:IRI ]
    ] .


# ------------------------------------------------------------------ #
# Causal edges
# ------------------------------------------------------------------ #
<#EdgeMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "ocg.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.edges[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/graph/{gid}/edge/{edge_key}" ;
        rr:class cw:CausalEdge
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "label" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:inGraph ;
        rr:objectMap [ rr:template "{graph_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:cause ;
        rr:objectMap [ rr:template "{cause_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:effect ;
        rr:objectMap [ rr:template "{effect_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:curated ;
        rr:objectMap [ rml:reference "curated" ; rr:datatype xsd:boolean ]
    ] ;
    # Absent on an edge an expert drew by hand: no method assigned it a strength.
    rr:predicateObjectMap [
        rr:predicate cw:weight ;
        rr:objectMap [ rml:reference "weight" ; rr:datatype xsd:double ]
    ] .

# One literal per relational path the edge may travel, in SPARQL 1.1
# property-path syntax (`<p>` forward, `^<p>` inverse, `/` sequence), so it can
# be pasted into a query to find the entity pairs the edge relates.  An
# intra-class (epsilon) edge has none: its cause and effect are one entity.
<#EdgePathMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "ocg.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.edge_paths[*]"
    ] ;
    rr:subjectMap [ rr:template "http://sdm-causalway.org/graph/{gid}/edge/{edge_key}" ] ;
    rr:predicateObjectMap [
        rr:predicate cw:viaRelationalPath ;
        rr:objectMap [ rml:reference "path" ]
    ] .
