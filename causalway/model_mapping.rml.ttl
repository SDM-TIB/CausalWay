# RML mapping: fitted-model JSON -> cw: RDF.
#
# This file *is* the specification of how a fitted model becomes triples.
# Nothing in `causalway/model_export.py` adds a triple of its own.  Change the
# shape of the exported model here, not in Python.
#
# The shape it writes:
#
#   model      cw:onGraph graph, cw:fittedBy run, cw:artifactChecksum?,
#              cw:hasMechanism mechanism*          (a CBN has no mechanisms)
#   run        cw:sourceKG, cw:byMethod, cw:fittedTime, cw:hasParameter param*
#   param      cw:parameterName, cw:parameterValue (typed), rdfs:comment?
#   mechanism  cw:onNode node, cw:mechanismType, cw:invertible
#
# A model is described, not stored: its fitted parameters live in `scm.pkl`,
# and `cw:artifactChecksum` is the sha256 of that file, so a reader holding an
# artifact can check it is the one that evaluated an answer.  Everything a
# trace needs beyond that — which graph, which data, which seed, which nodes
# admit a counterfactual — is here.
#
# Read `ocg_mapping.rml.ttl`'s header for the four engine constraints that
# dictate the shapes below; they apply here unchanged.  In particular the fit
# run's parameters reuse that file's plain/typed split, row for row.
#
# A mechanism's IRI is the model's IRI plus `/mechanism/{nodeKey}`, where
# `nodeKey` is the same slug-safe key the node's own IRI ends in.

@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix cw:   <http://sdm-causalway.org/> .

# --------------------------------------------------------------------------- #
# The model and the run that fitted it
# --------------------------------------------------------------------------- #
<#ModelMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "model.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.models[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/model/{model_key}" ;
        rr:class cw:CausalModel
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onGraph ;
        rr:objectMap [ rr:template "{graph_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:fittedBy ;
        rr:objectMap [ rr:template "{run_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:artifactChecksum ;
        rr:objectMap [ rml:reference "checksum" ]
    ] .

<#RunMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "model.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.runs[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/modelrun/{run_key}" ;
        rr:class cw:ModelFittingRun
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:sourceKG ;
        rr:objectMap [ rml:reference "source" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:byMethod ;
        rr:objectMap [ rml:reference "method" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:fittedTime ;
        rr:objectMap [ rml:reference "fitted_time" ; rr:datatype xsd:dateTime ]
    ] .

# --------------------------------------------------------------------------- #
# Fitting parameters — the same plain/typed split as a discovery run's.
# --------------------------------------------------------------------------- #
<#ParameterMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "model.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.parameters[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/modelrun/{run_key}/parameter/{param_key}" ;
        rr:class cw:Parameter
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:parameterName ;
        rr:objectMap [ rml:reference "name" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:parameterValue ;
        rr:objectMap [ rml:reference "value" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:comment ;
        rr:objectMap [ rml:reference "comment" ]
    ] .

<#ParameterTypedMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "model.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.parameters_typed[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/modelrun/{run_key}/parameter/{param_key}" ;
        rr:class cw:Parameter
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:parameterName ;
        rr:objectMap [ rml:reference "name" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:parameterValue ;
        rr:objectMap [ rml:reference "value" ; rml:datatypeMap [ rml:template "{datatype}" ] ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:comment ;
        rr:objectMap [ rml:reference "comment" ]
    ] .

<#RunHasParameterMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "model.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.run_parameters[*]"
    ] ;
    rr:subjectMap [ rr:template "http://sdm-causalway.org/modelrun/{run_key}" ] ;
    rr:predicateObjectMap [
        rr:predicate cw:hasParameter ;
        rr:objectMap [ rr:template "{parameter_iri}" ; rr:termType rr:IRI ]
    ] .

# --------------------------------------------------------------------------- #
# Mechanisms — one per node of a structural causal model.  cw:invertible is
# what says whether a counterfactual on the node is defined at all, which is
# why it is the one mechanism property kept.
# --------------------------------------------------------------------------- #
<#MechanismMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "model.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.mechanisms[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/model/{model_key}/mechanism/{node_key}" ;
        rr:class cw:CausalMechanism
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onNode ;
        rr:objectMap [ rr:template "{node_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:mechanismType ;
        rr:objectMap [ rml:reference "mechanism_type" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:invertible ;
        rr:objectMap [ rml:reference "invertible" ; rr:datatype xsd:boolean ]
    ] .

<#ModelHasMechanismMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "model.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.mechanisms[*]"
    ] ;
    rr:subjectMap [ rr:template "http://sdm-causalway.org/model/{model_key}" ] ;
    rr:predicateObjectMap [
        rr:predicate cw:hasMechanism ;
        rr:objectMap [ rr:template "{mechanism_iri}" ; rr:termType rr:IRI ]
    ] .
