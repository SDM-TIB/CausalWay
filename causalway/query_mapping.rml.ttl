# RML mapping: causal query + answer JSON -> cw: RDF.
#
# This file *is* the specification of how a query and its answer become
# triples.  Nothing in `causalway/query_export.py` adds a triple of its own;
# `queries_to_rdf` writes the JSON that `queries_to_json` produced, hands this
# mapping to SDM-RDFizer, and parses the result back.  Change the shape of the
# exported graph here, not in Python.
#
# Read `ocg_mapping.rml.ttl`'s header first — the three engine constraints it
# documents (no `rr:parentTriplesMap` onto a blank-node parent, the *opposite*
# IRI idioms in subject and object position, and irreversible quote rewriting
# through `rml:reference`) apply here unchanged, and the shapes below are what
# they force.  In particular:
#
#   * every subject template spells its IRI stem out literally and interpolates
#     only a slug-safe key, because a template subject handed a whole IRI is
#     percent-encoded and re-based against http://example.com/base/;
#   * a subject that *is* a foreign IRI — `<#NodeMap>` and `<#EntityHasQueryMap>`
#     — uses `rml:reference` + `rr:termType rr:IRI`, which is verbatim in that
#     position and percent-encoded in the other;
#   * a value is split across three arrays (plain / `_typed` / `_object`)
#     because the engine cannot switch term type or datatype per row.
#
# One idiom here is *not* in the sibling mappings.  `rdf:type` is an object map
# over `{class_iri}` rather than `rr:class`, because a query is one of three
# classes and an estimate is one of three, and `rr:class` is static per triples
# map.  Carrying the class as data collapses six near-identical triples maps
# — multiplied again by the value split — into two.
#
# The §6.1 *annotation* contract holds: nothing below asserts
# `entity property value`.  The only triple with a source-KG entity as subject
# is `cw:hasQuery`, which points at a query resource and contradicts nothing in
# the source graph.  The §6.8 named-graph projection, which deliberately does
# assert entity-level facts as quads, is not an export shape and is not here —
# it stays in `causalway.queries.store_query`.

@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix cw:   <http://sdm-causalway.org/> .

# --------------------------------------------------------------------------- #
# Layer B — the query (the query IRI is also the hypothetical world IRI)
# --------------------------------------------------------------------------- #
<#QueryMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.queries[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/query/{query_key}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:template "{class_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "label" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:usedModel ;
        rr:objectMap [ rr:template "{model_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:aboutEntity ;
        rr:objectMap [ rr:template "{entity}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:computedAt ;
        rr:objectMap [ rml:reference "computed_at" ; rr:datatype xsd:dateTime ]
    ] .

# Entity-first navigation. The entity is a *foreign* IRI in subject position,
# which is the one case `rml:reference` + `rr:termType rr:IRI` is needed — and
# a row whose key is missing crashes the engine rather than yielding no triple,
# which is why `queries_to_json` selects these rows in Python.
<#EntityHasQueryMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.queries_named[*]"
    ] ;
    rr:subjectMap [ rml:reference "entity" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate cw:hasQuery ;
        rr:objectMap [ rr:template "{query_iri}" ; rr:termType rr:IRI ]
    ] .

<#TargetMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.targets[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/query/{query_key}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:targetNode ;
        rr:objectMap [ rr:template "{node_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:targetProperty ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] .

# --------------------------------------------------------------------------- #
# The property nodes the query's terms point at.  Enough for the exported
# Turtle to be self-describing on its own, without the OCG export merged in.
# --------------------------------------------------------------------------- #
<#NodeMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.nodes[*]"
    ] ;
    rr:subjectMap [
        rml:reference "node_iri" ; rr:termType rr:IRI ; rr:class cw:PropertyNode
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "label" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:domain ;
        rr:objectMap [ rr:template "{domain}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:property ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:nodeKind ;
        rr:objectMap [ rml:reference "node_kind" ]
    ] .

# --------------------------------------------------------------------------- #
# Interventions — do(node := value).  Minted from their content, so two
# queries applying the same treatment share one resource (§6.3).
# --------------------------------------------------------------------------- #
<#InterventionMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.interventions[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/intervention/{intervention_key}" ;
        rr:class cw:Intervention
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onNode ;
        rr:objectMap [ rr:template "{node_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onProperty ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onEntity ;
        rr:objectMap [ rr:template "{entity}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:setValue ;
        rr:objectMap [ rml:reference "value" ]
    ] .

<#InterventionTypedMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.interventions_typed[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/intervention/{intervention_key}" ;
        rr:class cw:Intervention
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onNode ;
        rr:objectMap [ rr:template "{node_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onProperty ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onEntity ;
        rr:objectMap [ rr:template "{entity}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:setValue ;
        rr:objectMap [
            rml:reference "value" ; rml:datatypeMap [ rml:template "{datatype}" ]
        ]
    ] .

<#InterventionObjectMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.interventions_object[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/intervention/{intervention_key}" ;
        rr:class cw:Intervention
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onNode ;
        rr:objectMap [ rr:template "{node_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onProperty ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onEntity ;
        rr:objectMap [ rr:template "{entity}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:setValue ;
        rr:objectMap [ rr:template "{value_iri}" ; rr:termType rr:IRI ]
    ] .

# A soft intervention carries the *source text* of the callable and nothing
# else: `cw:setExpression` is informational, and replaying it needs the
# callable passed in explicitly (see Intervention.as_callable).
<#InterventionExpressionMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.interventions_expr[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/intervention/{intervention_key}" ;
        rr:class cw:Intervention
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onNode ;
        rr:objectMap [ rr:template "{node_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onProperty ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onEntity ;
        rr:objectMap [ rr:template "{entity}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:setExpression ;
        rr:objectMap [ rml:reference "expression" ]
    ] .

<#QueryHasInterventionMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.query_has_intervention[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/query/{query_key}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:hasIntervention ;
        rr:objectMap [ rr:template "{intervention_iri}" ; rr:termType rr:IRI ]
    ] .

<#QueryHasReferenceMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.query_has_reference[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/query/{query_key}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:referenceIntervention ;
        rr:objectMap [ rr:template "{intervention_iri}" ; rr:termType rr:IRI ]
    ] .

# --------------------------------------------------------------------------- #
# Conditions — an observed-value selector.  The vocabulary keeps *seeing* and
# *doing under a restriction* apart at the link, not at the resource:
# `cw:hasEvidence` is a conditional query's evidence, `cw:hasCondition` is the
# sub-population an interventional query's estimate is restricted to (a CATE).
# Both point at the same kind of resource, which is why one set of maps serves.
# --------------------------------------------------------------------------- #
<#ConditionMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.conditions[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/condition/{condition_key}" ;
        rr:class cw:Condition
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onNode ;
        rr:objectMap [ rr:template "{node_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onProperty ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:observedValue ;
        rr:objectMap [ rml:reference "observed_value" ]
    ] .

<#ConditionTypedMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.conditions_typed[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/condition/{condition_key}" ;
        rr:class cw:Condition
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onNode ;
        rr:objectMap [ rr:template "{node_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onProperty ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:observedValue ;
        rr:objectMap [
            rml:reference "observed_value" ;
            rml:datatypeMap [ rml:template "{datatype}" ]
        ]
    ] .

<#ConditionObjectMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.conditions_object[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/condition/{condition_key}" ;
        rr:class cw:Condition
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onNode ;
        rr:objectMap [ rr:template "{node_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onProperty ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:observedValue ;
        rr:objectMap [ rr:template "{value_iri}" ; rr:termType rr:IRI ]
    ] .

<#QueryHasEvidenceMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.query_has_evidence[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/query/{query_key}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:hasEvidence ;
        rr:objectMap [ rr:template "{condition_iri}" ; rr:termType rr:IRI ]
    ] .

<#QueryHasConditionMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.query_has_condition[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/query/{query_key}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:hasCondition ;
        rr:objectMap [ rr:template "{condition_iri}" ; rr:termType rr:IRI ]
    ] .

# --------------------------------------------------------------------------- #
# Layer C — the answer
# --------------------------------------------------------------------------- #
<#EstimateMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.estimates[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/answer/{estimate_key}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:template "{class_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:forQuery ;
        rr:objectMap [ rr:template "{query_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onNode ;
        rr:objectMap [ rr:template "{node_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onProperty ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onEntity ;
        rr:objectMap [ rr:template "{entity}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:predictedValue ;
        rr:objectMap [ rml:reference "value" ]
    ] .

<#EstimateTypedMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.estimates_typed[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/answer/{estimate_key}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:template "{class_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:forQuery ;
        rr:objectMap [ rr:template "{query_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onNode ;
        rr:objectMap [ rr:template "{node_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onProperty ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onEntity ;
        rr:objectMap [ rr:template "{entity}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:predictedValue ;
        rr:objectMap [
            rml:reference "value" ; rml:datatypeMap [ rml:template "{datatype}" ]
        ]
    ] .

<#EstimateObjectMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.estimates_object[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/answer/{estimate_key}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:template "{class_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:forQuery ;
        rr:objectMap [ rr:template "{query_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onNode ;
        rr:objectMap [ rr:template "{node_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onProperty ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onEntity ;
        rr:objectMap [ rr:template "{entity}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:predictedValue ;
        rr:objectMap [ rr:template "{value_iri}" ; rr:termType rr:IRI ]
    ] .

# One contrast, against `cw:referenceIntervention`.  A per-level contrast table
# is deliberately not exported — see `query_export.py`'s docstring, and the
# retired `cw:CategoricalDistribution` in `vocab.py` for the same subtraction.
<#EstimateEffectMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.estimate_effects[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/answer/{estimate_key}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:causalEffect ;
        rr:objectMap [ rml:reference "effect" ; rr:datatype xsd:decimal ]
    ] .
