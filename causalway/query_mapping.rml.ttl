# RML mapping: causal queries and their answers JSON -> cw: RDF.
#
# This file *is* the specification of how a query and its answers become
# triples — conditional, interventional and counterfactual alike, because in
# the cw: model they have one shape.  Nothing in `causalway/query_export.py`
# adds a triple of its own.  Change the shape of the exported graph here, not
# in Python.
#
# The shape it writes:
#
#   query         a cw:{Conditional|Interventional|Counterfactual}Query ;
#                 rdfs:label?, cw:onGraph graph,
#                 cw:hasIntervention intervention* (X), cw:hasCondition condition* (Z),
#                 cw:aboutEntity entity?          (counterfactual about a named unit)
#   intervention  cw:onNode, cw:onProperty, cw:setValue
#   condition     cw:onNode, cw:onProperty, cw:observedValue
#   answer        a cw:{Conditional|Interventional|Counterfactual}Answer ;
#                 cw:forQuery query, cw:evaluatedBy model, cw:evaluatedTime,
#                 cw:onNode, cw:onProperty, cw:predictedValue,
#                 cw:probability? (categorical) | cw:std? (continuous),
#                 cw:factualValue? (counterfactual)
#
# A query is posed on a *graph* and names no model; each answer names the model
# that evaluated it.  So one query resource can carry the answers of several
# models, and the target set V is simply the cw:onNode of the answers.
#
# Read `ocg_mapping.rml.ttl`'s header first — the engine constraints it
# documents apply here unchanged, and the shapes below are what they force:
#
#   * every subject template spells its IRI stem out literally and interpolates
#     only slug-safe keys, because a template subject handed a whole IRI is
#     percent-encoded and re-based against http://example.com/base/ — hence
#     `answer/{query_key}/{model_key}/{node_key}` as three fields;
#   * a value is split across three arrays (plain / `_typed` / `_object`)
#     because the engine can switch neither term type nor datatype per row, and
#     every `_typed` row carries a `datatype` (an absent one takes the whole
#     triples map down).
#
# One idiom here is *not* in the sibling mappings.  `rdf:type` is an object map
# over `{class_iri}` rather than `rr:class`, because a query is one of three
# classes and an answer is one of three, and `rr:class` is static per triples
# map.  Carrying the class as data collapses what would be eighteen
# near-identical triples maps into six.
#
# The annotation contract holds: nothing below asserts `entity property value`.
# The only link to a source-KG entity is `cw:aboutEntity`, whose subject is a
# query, so the output merges into the source KG without contradicting it.

@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix cw:   <http://sdm-causalway.org/> .

# --------------------------------------------------------------------------- #
# The query
# --------------------------------------------------------------------------- #
<#QueryMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.queries[*]"
    ] ;
    rr:subjectMap [ rr:template "http://sdm-causalway.org/query/{query_key}" ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:template "{class_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "label" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onGraph ;
        rr:objectMap [ rr:template "{graph_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:aboutEntity ;
        rr:objectMap [ rr:template "{entity}" ; rr:termType rr:IRI ]
    ] .

<#QueryHasInterventionMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.query_interventions[*]"
    ] ;
    rr:subjectMap [ rr:template "http://sdm-causalway.org/query/{query_key}" ] ;
    rr:predicateObjectMap [
        rr:predicate cw:hasIntervention ;
        rr:objectMap [ rr:template "{intervention_iri}" ; rr:termType rr:IRI ]
    ] .

<#QueryHasConditionMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.query_conditions[*]"
    ] ;
    rr:subjectMap [ rr:template "http://sdm-causalway.org/query/{query_key}" ] ;
    rr:predicateObjectMap [
        rr:predicate cw:hasCondition ;
        rr:objectMap [ rr:template "{condition_iri}" ; rr:termType rr:IRI ]
    ] .

# --------------------------------------------------------------------------- #
# Interventions — do(X = x).  Minted from (graph, node, value), so every query
# applying the same treatment on the same graph shares one resource.
# --------------------------------------------------------------------------- #
<#InterventionMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.interventions[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/intervention/{intervention_key}" ;
        rr:class cw:Intervention
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onNode ;
        rr:objectMap [ rr:template "{node_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onProperty ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:setValue ;
        rr:objectMap [ rml:reference "value" ]
    ] .

<#InterventionTypedMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.interventions_typed[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/intervention/{intervention_key}" ;
        rr:class cw:Intervention
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onNode ;
        rr:objectMap [ rr:template "{node_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onProperty ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:setValue ;
        rr:objectMap [ rml:reference "value" ; rml:datatypeMap [ rml:template "{datatype}" ] ]
    ] .

<#InterventionObjectMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.interventions_object[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/intervention/{intervention_key}" ;
        rr:class cw:Intervention
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onNode ;
        rr:objectMap [ rr:template "{node_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onProperty ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:setValue ;
        rr:objectMap [ rr:template "{value_iri}" ; rr:termType rr:IRI ]
    ] .

# --------------------------------------------------------------------------- #
# Conditions — Z = z.  Same split, same minting.
# --------------------------------------------------------------------------- #
<#ConditionMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.conditions[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/condition/{condition_key}" ;
        rr:class cw:Condition
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onNode ;
        rr:objectMap [ rr:template "{node_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onProperty ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:observedValue ;
        rr:objectMap [ rml:reference "value" ]
    ] .

<#ConditionTypedMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.conditions_typed[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/condition/{condition_key}" ;
        rr:class cw:Condition
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onNode ;
        rr:objectMap [ rr:template "{node_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onProperty ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:observedValue ;
        rr:objectMap [ rml:reference "value" ; rml:datatypeMap [ rml:template "{datatype}" ] ]
    ] .

<#ConditionObjectMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.conditions_object[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/condition/{condition_key}" ;
        rr:class cw:Condition
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onNode ;
        rr:objectMap [ rr:template "{node_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onProperty ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:observedValue ;
        rr:objectMap [ rr:template "{value_iri}" ; rr:termType rr:IRI ]
    ] .

# --------------------------------------------------------------------------- #
# Answers — one per (query, model, target node).  `cw:probability` travels on
# categorical answers and `cw:std` on continuous ones; `to_json` writes exactly
# one of the two keys.  `cw:factualValue` travels on counterfactual answers.
# --------------------------------------------------------------------------- #
<#AnswerMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.answers[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/answer/{query_key}/{model_key}/{node_key}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:template "{class_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:forQuery ;
        rr:objectMap [ rr:template "{query_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:evaluatedBy ;
        rr:objectMap [ rr:template "{model_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:evaluatedTime ;
        rr:objectMap [ rml:reference "evaluated_time" ; rr:datatype xsd:dateTime ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onNode ;
        rr:objectMap [ rr:template "{node_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onProperty ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:predictedValue ;
        rr:objectMap [ rml:reference "value" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:factualValue ;
        rr:objectMap [ rml:reference "factual" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:probability ;
        rr:objectMap [ rml:reference "probability" ; rr:datatype xsd:double ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:std ;
        rr:objectMap [ rml:reference "std" ; rr:datatype xsd:double ]
    ] .

# A typed value: the predicted and the factual value are the same variable in
# two worlds, so they share the one `datatype` of the row.
<#AnswerTypedMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.answers_typed[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/answer/{query_key}/{model_key}/{node_key}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:template "{class_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:forQuery ;
        rr:objectMap [ rr:template "{query_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:evaluatedBy ;
        rr:objectMap [ rr:template "{model_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:evaluatedTime ;
        rr:objectMap [ rml:reference "evaluated_time" ; rr:datatype xsd:dateTime ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onNode ;
        rr:objectMap [ rr:template "{node_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onProperty ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:predictedValue ;
        rr:objectMap [ rml:reference "value" ; rml:datatypeMap [ rml:template "{datatype}" ] ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:factualValue ;
        rr:objectMap [ rml:reference "factual" ; rml:datatypeMap [ rml:template "{datatype}" ] ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:probability ;
        rr:objectMap [ rml:reference "probability" ; rr:datatype xsd:double ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:std ;
        rr:objectMap [ rml:reference "std" ; rr:datatype xsd:double ]
    ] .

# An object-valued causal variable: both values are resources of the source KG.
# Such a node is categorical by construction, so it carries cw:probability.
<#AnswerObjectMap>
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "query.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator "$.answers_object[*]"
    ] ;
    rr:subjectMap [
        rr:template "http://sdm-causalway.org/answer/{query_key}/{model_key}/{node_key}"
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:template "{class_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:forQuery ;
        rr:objectMap [ rr:template "{query_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:evaluatedBy ;
        rr:objectMap [ rr:template "{model_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:evaluatedTime ;
        rr:objectMap [ rml:reference "evaluated_time" ; rr:datatype xsd:dateTime ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onNode ;
        rr:objectMap [ rr:template "{node_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:onProperty ;
        rr:objectMap [ rr:template "{property}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:predictedValue ;
        rr:objectMap [ rr:template "{value_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:factualValue ;
        rr:objectMap [ rr:template "{factual_iri}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate cw:probability ;
        rr:objectMap [ rml:reference "probability" ; rr:datatype xsd:double ]
    ] .
