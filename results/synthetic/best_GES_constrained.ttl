<http://sdm-causalway.org/run/ocg-15078d93349b/parameter/maxhop> a cw:Parameter ;
    cw:parameterName "maxhop" ;
    cw:parameterValue 1 ;
    rdfs:comment "Maximum number of object-property hops a relational path may take for an effect to pass between two classes." .

<http://sdm-causalway.org/run/ocg-15078d93349b/parameter/orientationSeed> a cw:Parameter ;
    cw:parameterName "orientationSeed" ;
    cw:parameterValue 0 ;
    rdfs:comment "Seed of the choice among Markov-equivalent orientations." .

<http://sdm-causalway.org/run/ocg-15078d93349b/parameter/orientedEdges> a cw:Parameter ;
    cw:parameterName "orientedEdges" ;
    cw:parameterValue 2 ;
    rdfs:comment "Number of undirected (CPDAG) edges whose direction was chosen within the Markov equivalence class, adding no v-structure and no cycle." .

