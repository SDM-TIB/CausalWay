cw:hasCondition a rdf:Property ;
    rdfs:label "hasCondition" ;
    rdfs:comment "A condition of the query (the set Z). On a counterfactual, the observed state of a hand-described unit." .

cw:hasIntervention a rdf:Property ;
    rdfs:label "hasIntervention" ;
    rdfs:comment "An intervention of the query (the set X; several = a joint do())." .

cw:hasMechanism a rdf:Property ;
    rdfs:label "hasMechanism" ;
    rdfs:comment "A cw:CausalMechanism of this model, one per node." .

cw:hasParameter a rdf:Property ;
    rdfs:label "hasParameter" ;
    rdfs:comment "A cw:Parameter of this run." .

cw:inGraph a rdf:Property ;
    rdfs:label "inGraph" ;
    rdfs:comment "The graph a node or an edge belongs to (exactly one)." .

cw:invertible a rdf:Property ;
    rdfs:label "invertible" ;
    rdfs:comment "Whether the mechanism's noise can be abducted from an observation — i.e. whether a counterfactual on this node is defined." .

cw:mechanismType a rdf:Property ;
    rdfs:label "mechanismType" ;
    rdfs:comment "Class name of the mechanism, e.g. InvertibleClassifierFCM." .

cw:observedValue a rdf:Property ;
    rdfs:label "observedValue" ;
    rdfs:comment "The value a condition observes." .

cw:onGraph a rdf:Property ;
    rdfs:label "onGraph" ;
    rdfs:comment "The causal graph a query is posed on, or a model is fitted on." .

cw:onNode a rdf:Property ;
    rdfs:label "onNode" ;
    rdfs:comment "The causal node an intervention, condition, answer or mechanism is about." .

cw:onProperty a rdf:Property ;
    rdfs:label "onProperty" ;
    rdfs:comment "Shortcut: the cw:property of cw:onNode." .

cw:parameterName a rdf:Property ;
    rdfs:label "parameterName" ;
    rdfs:comment "Name of a parameter, e.g. 'seed' or 'maxhop'." .

cw:parameterValue a rdf:Property ;
    rdfs:label "parameterValue" ;
    rdfs:comment "Value of a parameter, as a typed literal (xsd:integer, xsd:double, xsd:boolean or a plain string)." .

cw:predictedValue a rdf:Property ;
    rdfs:label "predictedValue" ;
    rdfs:comment "The answer: the most probable value of a categorical node, the mean of a continuous one." .

cw:probability a rdf:Property ;
    rdfs:label "probability" ;
    rdfs:comment "Categorical nodes only: the probability of cw:predictedValue." .

cw:property a rdf:Property ;
    rdfs:label "property" ;
    rdfs:comment "The property p of a causal node." .

cw:range a rdf:Property ;
    rdfs:label "range" ;
    rdfs:comment "Range R_p of a causal node: a class for an object property, a datatype for a data property. Deliberately not rdfs:range, for the reason given at cw:domain." .

cw:setValue a rdf:Property ;
    rdfs:label "setValue" ;
    rdfs:comment "The value an intervention sets its node to." .

cw:sourceKG a rdf:Property ;
    rdfs:label "sourceKG" ;
    rdfs:comment "The knowledge graph a run read: a file name or a SPARQL endpoint." .

cw:std a rdf:Property ;
    rdfs:label "std" ;
    rdfs:comment "Continuous nodes only: the standard deviation around cw:predictedValue." .

cw:viaRelationalPath a rdf:Property ;
    rdfs:label "viaRelationalPath" ;
    rdfs:comment "The relational path from the cause's domain to the effect's domain, as a SPARQL 1.1 property path: '<p>' a forward hop, '^<p>' an inverse hop, '/' a sequence. Absent on an intra-class (epsilon) edge, whose cause and effect belong to one entity." .

cw:weight a rdf:Property ;
    rdfs:label "weight" ;
    rdfs:comment "Method-assigned strength of the edge (a coefficient or a score). In a curated graph, the fraction of discovery runs that proposed the edge. Absent on an edge an expert added by hand." .

